// Frontend migrated from svelte/ to cljs/ (shadow-cljs + reagent + re-frame
// + jp-go-dds) during the cljs migration wave. "main" was dropped: it used
// to point at the removed SvelteKit-Cloudflare-adapter worker output
// (svelte/.svelte-kit/cloudflare/_worker.js), and src/app.ts (the actual
// production backend, kotodama-host-sdk) does not call env.ASSETS.fetch, so
// there is no worker entry that should serve these assets — Cloudflare's
// assets-only mode serves "assets" directly when "main" is absent.
// UNVERIFIED: this config has not been exercised against the live platform
// as part of the migration (no wrangler CLI invocation was run); it is a
// source-level edit only.
{
  "name": "kotodama-s3ibtsu1",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "seibutsu",
    "APP_CAPABILITIES": "[\"RegisterTaxon\",\"DeriveTraits\",\"IngestObservation\",\"GetProfile\",\"RenderProfile\",\"IdentifyFromImage\",\"ResolveLineage\",\"SyncGbif\",\"SyncWikidata\"]",
    "APP_DESCRIPTION": "Biological taxa and individual organisms as DID-addressed actors. Procedural-generation traits feed the kami-vegetation engine.",
    "APP_DISPLAY_NAME": "Seibutsu (生物)",
    "APP_EMBED_URL": "https://s3ibtsu1.itonami.cloud/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "s3ibtsu1",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "iframe",
    "GBIF_BASE_URL": "https://api.gbif.org/v1",
    "MURAKUMO_GATEWAY": "https://murakumo.itonami.cloud",
    "WIKIDATA_BASE_URL": "https://www.wikidata.org/wiki",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.itonami.cloud/xrpc/cloud.itonami.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "s3ibtsu1.itonami.cloud/*",
      "zone_name": "itonami.cloud"
    },
    {
      "pattern": "seibutsu.itonami.cloud/*",
      "zone_name": "itonami.cloud"
    }
  ]
}
